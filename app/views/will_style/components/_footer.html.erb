<% unless defined?(saas_link) %>
	<% saas_link = "https://willinteractive.com/saas" %>
<% end %>

<% unless defined?(privacy_link) %>
	<% privacy_link = "https://willinteractive.com/privacy" %>
<% end %>

<% unless defined?(terms_link) %>
	<% terms_link = "https://willinteractive.com/terms" %>
<% end %>

<% unless defined?(include_bg) %>
	<% include_bg = true %>
<% end %>

<footer class="footer mt-auto py-3 <%= include_bg ? "bg-dark" : "text-shadow" %> <%= defined?(root_classes) ? root_classes : "" %>">
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<p class="text-center mb-0 text-light line-height-1">
					<small class="d-flex align-items-center justify-content-center gap-4">
						<span class="d-flex align-items-center justify-content-center gap-1">
							&copy;<%= Time.now.year %>
							<%= image_tag "will-style/logos/master-logos/master-light.svg", alt: "WILL Interactive Logo", class: "img-fluid copyright-logo" %>
						</span>

						<%= link_to "Privacy Policy", privacy_link, target: :blank, class: "text-light animated fw-bold" %>
						<%= link_to "SaaS Agreement", saas_link, target: :blank, class: "text-light animated fw-bold" %>
						<%= link_to "Terms", terms_link, target: :blank, class: "text-light animated fw-bold" %>

						<% if defined?(support_link) %>
							<%= link_to "Support", support_link, target: :blank, class: "text-light animated fw-bold" %>
						<% end %>
					</small>
				</p>
			</div>
		</div>
	</div>
</footer>
